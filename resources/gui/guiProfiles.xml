<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    FS25 port of Guidance Steering's GUI profiles (rebuilt).

    The two settings frames were rebuilt on GIANTS' standard FS25 settings-page pattern,
    verified against Courseplay's CpGlobalSettingsFrame/CpVehicleSettingsFrame and the base
    GlobalSettingsFrame they mirror. Those frames rely almost entirely on base-game fs25_*
    profiles which exist at runtime (fs25_menuContainer, fs25_settingsLayout,
    fs25_settingsMultiTextOption, fs25_settingsMultiTextOptionTitle,
    fs25_multiTextOptionContainer, fs25_settingsSectionHeader, fs25_sliderDocked*,
    fs25_listSlider*, fs25_lineSeparatorTopHighlighted, fs25_menuHeader*). Those are used
    DIRECTLY in the frame XML and are NOT redefined here.

    Key fact that makes the rows work: fs25_settingsMultiTextOption carries
    autoAddDefaultElements + defaultProfileButtonLeft/Right/Text/Bg, so a bare
    <MultiTextOption profile="fs25_settingsMultiTextOption"> auto-creates its left/right
    arrow buttons (correct FS25 slice), value text and row background. We only declare the
    "label" child (the row title). This is exactly how Courseplay declares its rows.

    This file therefore only defines the handful of gs-prefixed profiles the rebuilt frames
    still need: text/value/tooltip text styling, the plain (glyph-free) action buttons for
    width/offset, the two strategy columns, the self-contained text input, and the track
    SmoothList styling. All use FS25 new-format <propertyName value="..."/> attributes
    (GuiProfile:loadFromXML treats a bare <Value name="X" value="Y"/> child as deprecated
    and logs "still uses old format" for each one).
-->
<GUIProfiles>
    <Presets>
        <Preset name="colorWhite" value="1 1 1 1" />
        <Preset name="colorMainUI" value="0.0227 0.5346 0.8519 1.0" />
        <Preset name="colorGlassExtremelyLight" value="0.918 0.916 0.915 0.15" />
        <Preset name="colorGlassLight" value="0.718 0.716 0.715 0.25" />
        <Preset name="colorGlassLight_50" value="0.718 0.716 0.715 0.0625" />
        <Preset name="colorListRowBackground" value="$preset_colorGlassLight_50" />
        <!-- Dark, translucent settings-row background. Mirrors the shade GIANTS' settings
             frame / Courseplay apply per row via setImageColor(1, fs25_colorGreyDark_50)
             (cp/scripts/CpSettingsUtil.lua:295). -->
        <Preset name="colorRowBg" value="0.0075 0.0075 0.0075 0.6" />
        <!-- FS25's signature UI accent green (GIANTS' selected/positive colour). Ground truth:
             Precision Farming tints its positive-change readout with this exact value
             (pf/gui/FarmlandStatsDialog.xml:206). Used for the action buttons' focused/pressed
             text, matching the green key text on the base game's input-hint pill. -->
        <Preset name="colorFs25Green" value="0.3763 0.6038 0.0782 1" />
    </Presets>

    <Traits>
        <!-- Local replacement for the base "alternateRow" trait (fate unconfirmed in FS25). -->
        <Trait name="gsAlternateRow">
            <imageColor value="$preset_colorGlassExtremelyLight" />
        </Trait>
    </Traits>

    <!-- ============================================================= -->
    <!-- Settings/strategy MultiTextOption row: extend the base row profiles CP uses, fixing
         the two things CP fixes in Lua/GUIProfiles that a static declaration otherwise misses. -->
    <!-- ============================================================= -->

    <!-- Row title. The base fs25_settingsMultiTextOptionTitle positions the label over the
         value box; Courseplay corrects this with a -500px shift (cpSettingsMultiOptionTitle in
         cp/config/gui/GUIProfiles.xml). Mirror it exactly so the label sits in the row's left
         area instead of overlapping the value/arrows. -->
    <Profile name="gsSettingsMultiOptionTitle" extends="fs25_settingsMultiTextOptionTitle">
        <position value="-500px 0px" />
    </Profile>

    <!-- Row background. The base fs25_multiTextOptionContainer ships a bright default image
         color; GIANTS' settings frame and Courseplay recolor every row in Lua via
         setImageColor(1, fs25_colorGreyDark[_50]) (cp/scripts/CpSettingsUtil.lua:293-295).
         Our rows are declared statically and never get that call, so the bright default shows
         as a white block behind each row (which also washes out the value/label text). Supply
         the dark row color here instead. -->
    <Profile name="gsMultiTextOptionContainer" extends="fs25_multiTextOptionContainer">
        <imageColor value="$preset_colorRowBg" />
    </Profile>

    <!-- ============================================================= -->
    <!-- Self-contained text base (no dependency on removed base profiles) -->
    <!-- ============================================================= -->

    <Profile name="gsTextBase">
        <type value="text" />
        <textSize value="16px" />
        <textColor value="$preset_colorWhite" />
        <textVerticalAlignment value="middle" />
        <textAlignment value="left" />
    </Profile>

    <!-- Tooltip / help line shown at the bottom of each frame. Target of every row's
         toolTipElementId (a Text: has setText, unlike the old help-box Bitmap). -->
    <Profile name="gsTooltipText" extends="gsTextBase">
        <size value="900px 40px" />
        <textSize value="15px" />
        <textMaxWidth value="900px" />
        <textColor value="0.85 0.85 0.85 1" />
        <position value="35px 24px" />
    </Profile>

    <!-- Width / offset current-value readout (highlighted). -->
    <Profile name="gsValueText" extends="gsTextBase">
        <size value="170px 45px" />
        <textSize value="20px" />
        <textBold value="true" />
        <textColor value="$preset_colorMainUI" />
        <textAlignment value="left" />
    </Profile>

    <Profile name="gsRowLabel" extends="gsTextBase">
        <size value="300px 45px" />
        <textSize value="16px" />
        <textMaxWidth value="300px" />
    </Profile>

    <!-- Compact settings section header. The base fs25_settingsSectionHeader is ~80px tall
         (160px @2160p in the GUI_DEBUG dump) plus a generous vertical margin; five of them
         are the main space-eater the user flagged ("so much empty space"). Shrink the box to
         50px (100px @2160p) via a height override and trim the margin, inheriting text
         style/size/vertical-centring from the base so the label stays legible. This claws
         ~60px @2160p back per header (~300px total across the settings tab, ~120px across the
         strategy tab's two headers). -->
    <Profile name="gsSectionHeader" extends="fs25_settingsSectionHeader">
        <height value="50px" />
        <margin value="0px 4px 0px 2px" />
    </Profile>

    <!-- Section header for the right column, which is a PLAIN GuiElement (not a BoxLayout).
         gsSectionHeader extends fs25_settingsSectionHeader, whose anchor/margin behaviour only
         resolves correctly inside a settings-layout cell; dropped into the plain trackListBox it
         doubled the header's Y offset and threw it off-screen (GUI_DEBUG: topFromTop=-499). This
         self-contained profile extends gsTextBase (no layout base), so an explicitly positioned
         Text follows the clean bottom-left model (verified against the empty-state text). Bold +
         uppercase to read like the left column's headers. -->
    <Profile name="gsRightSectionHeader" extends="gsTextBase">
        <textSize value="20px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textVerticalAlignment value="middle" />
    </Profile>

    <!-- ============================================================= -->
    <!-- Plain action buttons (glyph-free: they do NOT extend buttonBack, so they carry no
         MENU_BACK input glyph, which was the source of the stray "ESC" blocks). -->
    <!-- ============================================================= -->

    <!-- Chrome-LESS action button. The visible rounded pill is drawn by a sibling gsButtonPill
         ThreePartBitmap placed directly behind each button in the frame XML (FS25's ButtonElement
         can only draw a single stretched slice, so a button on its own cannot have rounded ends -
         see the gsButtonPill comment). This button therefore carries NO image slice; all state
         feedback comes from its TEXT colour, exactly like the base game's input-hint pill (dark
         pill, coloured key text). Rest = near-white; hover (highlight) = full white; focus/press =
         FS25 green (there is no separate pressed-text state in TextElement:getTextColor, so a
         pressed button - which is also focused - shows the focused green). -->
    <Profile name="gsSettingsButton">
        <type value="button" />
        <size value="60px 45px" />
        <textSize value="20px" />
        <textBold value="true" />
        <textColor value="0.9 0.9 0.9 1" />
        <textHighlightedColor value="$preset_colorWhite" />
        <textFocusedColor value="$preset_colorFs25Green" />
        <textSelectedColor value="$preset_colorFs25Green" />
        <textAlignment value="center" />
        <textVerticalAlignment value="middle" />
    </Profile>

    <Profile name="gsSettingsButtonWide" extends="gsSettingsButton">
        <size value="170px 45px" />
        <textSize value="16px" />
    </Profile>

    <!-- Native rounded "pill" chrome, drawn as a static sibling BEHIND each action button.
         Why a separate element: ButtonElement draws a single stretched background slice
         (ButtonElement:draw -> GuiOverlay.renderOverlay, elements/ButtonElement.lua:619), and the
         only flat button slice is gui.button_middle -> squared corners. GIANTS build rounded action
         buttons by pairing a transparent Button with a ThreePartBitmap background (base
         fs25_mapButtonBgLight, used in Courseplay CourseGeneratorFrame.xml:60-63). We reproduce that
         with the base UI's own 3-part button pill: gui.button_left cap + gui.button_middle stretch +
         gui.button_right cap - the exact slices the engine composes for the input-hint key pill
         (base/ButtonOverlay.lua:24-26). With no children this ThreePartBitmap is non-focusable
         (BitmapElement:canReceiveFocus, BitmapElement.lua:238-240), so it is pure decoration and does
         not disturb button focus/hit-testing. Cap width 11px scales the native 6/25 cap:height ratio
         (ButtonOverlay.lua:27) to the 45px button height. Same dark fill as the previous button face. -->
    <Profile name="gsButtonPill">
        <imageSliceId value="gui.button_middle" />
        <startImageSliceId value="gui.button_left" />
        <endImageSliceId value="gui.button_right" />
        <startImageSize value="11px 45px" />
        <endImageSize value="11px 45px" />
        <imageColor value="0.055 0.055 0.055 0.9" />
        <startImageColor value="0.055 0.055 0.055 0.9" />
        <endImageColor value="0.055 0.055 0.055 0.9" />
    </Profile>

    <!-- Container that holds a value readout + its action buttons on one row inside the
         settings ScrollingLayout. Children are placed at explicit positions so no nested
         layout pass is required. -->
    <Profile name="gsButtonRow" extends="emptyPanel">
        <size value="1000px 55px" />
        <margin value="30px 2px 15px 2px" />
    </Profile>

    <!-- ============================================================= -->
    <!-- Self-contained text input (no FS25 base reference; keeps the FS25 draw fix). -->
    <!-- ============================================================= -->

    <Profile name="gsTextInput">
        <type value="textInput" />
        <size value="360px 48px" />
        <!-- REQUIRED: TextInputElement:draw does (size[1] - maxInputTextWidth)/2 every frame,
             unconditionally. Without maxInputTextWidth it defaults to nil and the draw call
             throws "arithmetic (sub) on number and nil". Must be < size width. -->
        <maxInputTextWidth value="340px" />
        <textSize value="16px" />
        <textColor value="$preset_colorWhite" />
        <textColorSelected value="$preset_colorMainUI" />
        <textVerticalAlignment value="middle" />
        <textAlignment value="left" />
        <textOffset value="10px 0px" />
        <!-- Visible box. imageColor alone tints nothing without an image to draw, so the field
             showed just the typed value with no box (same overlay rule as the buttons above).
             gui.button_middle gives the input a real box face; colorRowBg keeps it dark, brightening
             on focus. -->
        <imageSliceId value="gui.button_middle" />
        <imageColor value="$preset_colorRowBg" />
        <!-- Focus highlight. colorGlassLight (0.72 grey) drew as a jarring light-grey block
             behind the focused Track name field (user-flagged) that looked inconsistent with the
             dark, unfocused inputs. Use a subtle dark brighten instead so focus is still legible
             but the field stays in the same dark family as the rest. Applies to every gsTextInput
             (Track name + headland distance) so both remain consistent. -->
        <imageFocusedColor value="0.15 0.15 0.15 0.75" />
    </Profile>

    <!-- Single settings-style row: label on the left, boxed TextInput on the right (positions
         set on the children in the frame XML), matching the height of the selector rows. -->
    <Profile name="gsTextInputRow" extends="emptyPanel">
        <size value="700px 55px" />
        <margin value="30px 2px 15px 2px" />
    </Profile>

    <!-- ============================================================= -->
    <!-- Strategy frame two-column layout (controls left, track list right). -->
    <!-- ============================================================= -->

    <!-- Left control column, pinned with its TOP just under the header separator.
         GROUND TRUTH from the GUI_DEBUG dump + GuiElement:updateAnchorDeltas: FS25's Y origin
         is bottom-left and a child's #position is ALWAYS an offset from the parent's BOTTOM-left
         corner (anchors only re-expand frozen deltas when the parent later resizes; our parent
         'container' is static, so anchors don't move this box; only position/size do). The
         previous "-70px" therefore pinned the box BOTTOM 70px below the parent bottom, so the
         box (and its top-aligned content) hung off the lower edge (measured top at 1280px @2160p).
         With alignmentY="top" content always starts at the box TOP, so pinning the top = choosing
         position.y so that  parentBottom + position.y + size.y == desiredTop.
         Parent 'container': bottom=0.0741, top=0.8426 (height 0.7685). Target top ~= 474px @2160p
         (topFrac 0.7801, just under the separator at 454px). With size.y=400px (0.3704 frac,
         ~fits the ~780px @2160p content after the header shrink): position.y = (0.7801-0.3704)
         - 0.0741 = 0.3356 frac = 363px. Screen<->ref px: X = px/1920, Y = px/1080 (1 ref px = 2
         screen px @3840x2160). -->
    <Profile name="gsStrategyLeftColumn" extends="emptyPanel">
        <size value="720px 400px" />
        <position value="30px 363px" />
        <flowDirection value="vertical" />
        <alignmentY value="top" />
    </Profile>

    <!-- Right column X derivation (GUI_DEBUG-measured): the widest left rows (the two
         gsMultiTextOptionContainer rows) overflow the 720px left column, ending at ~844.5 ref
         from the container's left. The previous x=780 put this column's left edge (and thus the
         list + empty-state text) INSIDE those rows (~65 ref overlap, unreadable jumble). Move the
         left edge to 885 ref: ~40 ref gutter past the widest row (844.5), and content still ends
         at 885+609=1494 ref, 56 ref clear of the container's 1550 ref right edge. No list narrowing
         needed (container had 161 ref of right-side slack). -->
    <Profile name="gsStrategyRightColumn" extends="emptyPanel">
        <size value="620px 540px" />
        <position value="885px 223px" />
    </Profile>

    <!-- ============================================================= -->
    <!-- Track list (FS25 SmoothList: standalone layout profile, no removed base). -->
    <!-- ============================================================= -->

    <Profile name="gsTrackList" extends="emptyPanel">
        <!-- 484px (not 540) leaves room at the column top for the SAVED TRACKS section header
             (the list now starts ~110px below the column top, mirroring AFM/Courseplay's
             header-above-list layout). Rows fill from the top with the default SmoothList
             alignment (no listItemAlignment override) — the same as every working FS25 list
             (e.g. Courseplay's course list). An earlier listItemAlignment="end" was removed from
             the frame XML: it pushed the single rendered cell out of the clip rect (invisible). -->
        <size value="590px 484px" />
        <selectOnScroll value="true" />
        <isHorizontalList value="false" />
        <itemsPerCol value="11" />
        <listItemHeight value="49px" />
        <listItemWidth value="590px" />
        <rowBackgroundProfile value="gsTrackListItem" />
        <rowBackgroundProfileAlternate value="gsTrackListItemAlternate" />
    </Profile>

    <!-- Docked scrollbar for the track list. The base fs25_listSliderBox positions itself from
         the parent's right/anchored edge, which put the bare element far off-screen (measured
         x=4445 of 3840 in the GUI_DEBUG dump). AFM/Courseplay fix this by re-anchoring the slider
         box top-left and giving it an explicit position beside the list; mirror that. x=600px sits
         just right of the 590px list; y=-112px drops it to the list top (112px below the column
         top, matching the header offset); height 484px matches the list. -->
    <Profile name="gsTrackListSliderBox" extends="fs25_listSliderBox" with="anchorTopLeft">
        <size value="9px 484px" />
        <position value="600px -112px" />
    </Profile>

    <Profile name="gsTrackListItem">
        <type value="listItem" />
        <!-- REQUIRED for any row visuals to draw: like the buttons/text-input above, imageColor
             tints nothing without an image slice, so the rows (and, crucially, the selected-row
             highlight) were invisible. gui.button_middle is the proven flat slice used elsewhere
             in this frame. Unselected rows stay near-transparent (colorListRowBackground alpha),
             selected/focused rows show the opaque UI blue so the current track is visible. -->
        <imageSliceId value="gui.button_middle" />
        <imageColor value="$preset_colorListRowBackground" />
        <imageFocusedColor value="$preset_colorMainUI" />
        <imageSelectedColor value="$preset_colorMainUI" />
        <size value="590px 47px" />
        <position value="0px 0px" />
    </Profile>
    <Profile name="gsTrackListItemAlternate" extends="gsTrackListItem" with="gsAlternateRow" />

    <Profile name="gsTrackListItemTitle" extends="gsTextBase">
        <size value="590px 47px" />
        <textMaxWidth value="560px" />
        <textVerticalAlignment value="middle" />
        <textSize value="17px" />
        <textBold value="false" />
        <textOffset value="20px 2px" />
        <textFocusedOffset value="20px 2px" />
    </Profile>

    <!-- Empty-state helper text, shown in the track-list column when there are no saved tracks.
         Positioned near the top of the 620x540 right column (position is from the column's
         bottom-left), wrapping within the list width. -->
    <Profile name="gsTrackListEmptyText" extends="gsTextBase">
        <size value="560px 120px" />
        <!-- Sits just under the SAVED TRACKS header, at the top of the (now shorter) list area
             so the empty message reads directly below the header. -->
        <position value="20px 357px" />
        <textMaxWidth value="540px" />
        <textSize value="17px" />
        <textColor value="0.85 0.85 0.85 1" />
        <textVerticalAlignment value="top" />
        <textAlignment value="left" />
    </Profile>
</GUIProfiles>
