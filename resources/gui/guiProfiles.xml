<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    FS25 port of Guidance Steering's GUI profiles.

    The FS22 version extended ~12 base-game profiles that GIANTS renamed or removed in
    FS25's UI redesign. Re-parenting map (verified against GIANTS' own PrecisionFarming
    and Courseplay FS25 GUI XMLs, and the FS25 dataS dump):

      dialogBg                       -> fs25_dialogBg                (verified exists)
      ingameMenuSettingsLayout       -> local gsLayout (extends emptyPanel; verified survivor)
      settingsMenuSubtitle           -> fs25_settingsSectionHeader   (verified exists)
      multiTextOptionBg/Left/Right/Text -> unchanged                 (verified survivors)
      multiTextOptionTitle           -> local (unconfirmed base; self-contained text)
      multiTextOptionSettings        -> local (removed base)
      verticalListSliderRightDocked  -> fs25_listSliderBox           (verified exists)
      verticalListSliderBar          -> fs25_listSlider              (verified exists)
      ingameMenuWeather*Separator    -> fs25_lineSeparatorTop        (verified exists)
      ingameMenuGameSettingsTextInput-> local (no FS25 reference; self-contained)
      ingameMenuSettingsPauseButton  -> buttonBack                   (verified survivor)
      list / listItem                -> local self-contained (SmoothList reads layout props)
      framedEmptyPanel / wardrobeListFrame / settingsBox -> emptyPanel (verified survivor)
      textDefault                    -> local gsTextBase (self-contained; avoids dependency)

    Anything marked "local/self-contained" resolves without a base lookup so an unknown
    base name can never leave an element unstyled-and-nil. Cosmetics may need in-game
    tuning; correctness (element resolves, Lua controls bind) does not depend on it.

    The old menu-shell profiles (paging buttons, tab list, page-tab, header selector
    wrappers) were dropped. The FS25 menu shell (GuidanceSteeringMenu.xml) now uses the
    base fs25_tabList* / fs25_buttonBox / fs25_fullScreenBackground profiles directly.
-->
<GUIProfiles>
    <Presets>
        <Preset name="colorTransparent" value="0 0 0 0" />
        <Preset name="colorGlassVeryLight" value="0.718 0.716 0.715 0.04" />
        <Preset name="colorGlassExtremelyLight" value="0.918 0.916 0.915 0.15" />
        <Preset name="colorGlassLight" value="0.718 0.716 0.715 0.25" />
        <Preset name="colorGlassLight_50" value="0.718 0.716 0.715 0.0625" />

        <Preset name="colorMainUI"    value="0.0227 0.5346 0.8519 1.0"/>
        <Preset name="colorWhite" value="1 1 1 1" />
        <Preset name="colorListRowBackground" value="$preset_colorGlassLight_50" />
    </Presets>

    <Traits>
        <Trait name="anchorTopLeft">
            <Value name="screenAlign" value="topLeft" />
            <Value name="positionOrigin" value="topLeft" />
        </Trait>
        <Trait name="anchorTopCenter">
            <Value name="screenAlign" value="topCenter" />
            <Value name="positionOrigin" value="topCenter" />
        </Trait>
        <!-- Local replacement for the base "alternateRow" trait (fate unconfirmed in FS25). -->
        <Trait name="gsAlternateRow">
            <Value name="imageColor" value="$preset_colorGlassExtremelyLight" />
        </Trait>
    </Traits>

    <!-- ============================================================= -->
    <!-- Self-contained base building blocks (no dependency on removed base profiles) -->
    <!-- ============================================================= -->

    <Profile name="gsTextBase">
        <Value name="type" value="text" />
        <Value name="textSize" value="16px" />
        <Value name="textColor" value="$preset_colorWhite" />
        <Value name="textVerticalAlignment" value="middle" />
        <Value name="textAlignment" value="left" />
    </Profile>

    <Profile name="gsLayout" extends="emptyPanel">
        <Value name="flowDirection" value="vertical" />
    </Profile>

    <Profile name="gsPanel" extends="emptyPanel" />

    <!-- ============================================================= -->
    <!-- Dialog backgrounds -->
    <!-- ============================================================= -->

    <Profile name="guidanceSteeringDialogBg" extends="fs25_dialogBg">
        <Value name="size" value="1280px 720px" />
    </Profile>

    <Profile name="guidanceSteeringDialogBgWide" extends="fs25_dialogBg">
        <Value name="size" value="1280px 758px" />
    </Profile>

    <!-- ============================================================= -->
    <!-- Settings container / layout (replaces settingsBox, ingameMenuSettingsBox, ingameMenuSettingsLayout) -->
    <!-- ============================================================= -->

    <Profile name="settingsBox" extends="emptyPanel">
        <Value name="size" value="1280px 600px" />
    </Profile>

    <Profile name="ingameMenuSettingsBox" extends="emptyPanel" />

    <Profile name="ingameMenuSettingsLayout" extends="emptyPanel">
        <Value name="flowDirection" value="vertical" />
    </Profile>

    <Profile name="ingameMenuGameSettingsTextInputWrapper" extends="emptyPanel" />

    <Profile name="wardrobeListFrame" extends="emptyPanel" />
    <Profile name="framedEmptyPanel" extends="emptyPanel" />

    <!-- Section subtitle (was settingsMenuSubtitle) -->
    <Profile name="settingsMenuSubtitle" extends="fs25_settingsSectionHeader" />

    <!-- ============================================================= -->
    <!-- Separators (were ingameMenuWeather*Separator) -->
    <!-- ============================================================= -->

    <Profile name="ingameMenuWeatherVerticalSeparator" extends="fs25_lineSeparatorTop" />
    <Profile name="ingameMenuWeatherHorizontalSeparator" extends="fs25_lineSeparatorTop" />

    <!-- ============================================================= -->
    <!-- Sliders (were verticalListSliderRightDocked / verticalListSliderBar) -->
    <!-- ============================================================= -->

    <Profile name="verticalListSliderRightDocked" extends="fs25_listSliderBox" />
    <Profile name="verticalListSliderBar" extends="fs25_listSlider" />

    <!-- ============================================================= -->
    <!-- multiTextOption option-title (unconfirmed base multiTextOptionTitle) -->
    <!-- ============================================================= -->

    <Profile name="multiTextOptionTitle" extends="gsTextBase">
        <Value name="textSize" value="15px" />
        <Value name="textColor" value="$preset_colorWhite" />
        <Value name="textMaxWidth" value="250px" />
    </Profile>

    <!-- ============================================================= -->
    <!-- Text -->
    <!-- ============================================================= -->

    <Profile name="detailText" extends="gsTextBase">
        <Value name="textSize" value="28px" />
        <Value name="textColor" value="$preset_colorMainUI" />
        <Value name="size" value="250px 24px" />
        <Value name="textBold" value="true" />
        <Value name="margin" value="0px 0px 50px 0px" />
        <Value name="textAlignment" value="center" />
        <Value name="textVerticalAlignment" value="middle" />
    </Profile>

    <!-- ============================================================= -->
    <!-- Buttons (guidanceButton was ingameMenuSettingsPauseButton) -->
    <!-- ============================================================= -->

    <Profile name="guidanceButton" extends="buttonBack">
        <Value name="screenAlign" value="bottomLeft" />
        <Value name="positionOrigin" value="bottomLeft" />
        <Value name="margin" value="15px 15px 15px 15px" />
        <Value name="iconSize" value="0px 0px" />
        <Value name="position" value="0px 0px" />
        <Value name="textBold" value="false" />
        <Value name="textSize" value="16px" />
        <Value name="iconColor" value="$preset_colorWhite" />
        <Value name="iconHighlightedColor" value="$preset_colorMainUI" />
    </Profile>

    <Profile name="guidanceButtonDetail" extends="guidanceButton">
        <Value name="size" value="205px 75px" />
        <Value name="margin" value="30px 5px 30px 5px" />
        <Value name="textSize" value="16px" />
        <Value name="textBold" value="true" />
        <Value name="position" value="0px 0px" />
        <Value name="textAlignment" value="center" />
        <Value name="textVerticalAlignment" value="middle" />
    </Profile>

    <Profile name="guidanceButtonDetailLeft" extends="guidanceButtonDetail">
        <Value name="margin" value="40px 15px 40px 15px" />
        <Value name="textOffset" value="-5px 0px" />
        <Value name="size" value="50px 50px" />
        <Value name="iconSize" value="50px 50px" />
        <Value name="iconTextOffset" value="10px 0px" />
    </Profile>

    <Profile name="guidanceButtonDetailRight" extends="guidanceButtonDetail">
        <Value name="margin" value="15px 15px 40px 15px" />
        <Value name="textOffset" value="-5px 0px" />
        <Value name="size" value="50px 50px" />
        <Value name="iconSize" value="50px 50px" />
        <Value name="iconTextOffset" value="10px 0px" />
    </Profile>

    <Profile name="guidanceSettingsButton" extends="guidanceButton">
        <Value name="margin" value="35px 15px 35px 15px" />
    </Profile>

    <!-- ============================================================= -->
    <!-- Text input (was ingameMenuGameSettingsTextInput; no FS25 reference: self-contained) -->
    <!-- ============================================================= -->

    <Profile name="guidanceSettingsTextInput">
        <Value name="type" value="textInput" />
        <Value name="size" value="250px 48px" />
        <Value name="textSize" value="16px" />
        <Value name="textColor" value="$preset_colorWhite" />
        <Value name="textColorSelected" value="$preset_colorMainUI" />
        <Value name="textVerticalAlignment" value="middle" />
        <Value name="textAlignment" value="left" />
        <Value name="textOffset" value="10px 0px" />
        <Value name="imageColor" value="$preset_colorGlassLight_50" />
        <Value name="imageFocusedColor" value="$preset_colorGlassLight" />
        <Value name="margin" value="35px 42px 35px 16px" />
    </Profile>

    <!-- ============================================================= -->
    <!-- multiTextOption wrappers (was multiTextOptionSettings) -->
    <!-- ============================================================= -->

    <Profile name="guidanceMultiTextOptionSettings" extends="guidanceButton">
        <Value name="size" value="250px 48px" />
        <Value name="margin" value="15px 42px 15px 16px" />
    </Profile>

    <Profile name="guidanceSettingsMultiTextOptionSettings" extends="guidanceButton">
        <Value name="margin" value="35px 42px 35px 16px" />
    </Profile>

    <Profile name="guidanceHeadlandMultiTextOptionSettings" extends="guidanceButton">
        <Value name="margin" value="35px 42px 35px 16px" />
    </Profile>

    <Profile name="guidanceMultiTextOptionBg" extends="multiTextOptionBg">
        <Value name="size" value="155px 48px" />
    </Profile>

    <Profile name="guidanceMultiTextOptionText" extends="multiTextOptionText">
        <Value name="textMaxWidth" value="100px" />
    </Profile>

    <Profile name="guidanceMultiTextOptionTitle" extends="multiTextOptionTitle">
        <Value name="textMaxWidth" value="250px" />
    </Profile>

    <!-- ============================================================= -->
    <!-- Image cell background (was baseReference; survives) -->
    <!-- ============================================================= -->

    <Profile name="cellImageBackground" extends="baseReference">
        <Value name="size" value="200px 200px" />
        <Value name="margin" value="25px 25px 25px 25px" />
    </Profile>

    <!-- ============================================================= -->
    <!-- Tooltip / help row (was ingameMenuHelpRow*) -->
    <!-- ============================================================= -->

    <Profile name="ingameMenuHelpRowBg" extends="emptyPanel">
        <Value name="size" value="600px 60px" />
        <Value name="imageColor" value="$preset_colorGlassLight_50" />
    </Profile>

    <Profile name="ingameMenuHelpRowIcon" extends="emptyPanel">
        <Value name="size" value="40px 40px" />
    </Profile>

    <Profile name="ingameMenuHelpRowText" extends="gsTextBase">
        <Value name="size" value="540px 60px" />
        <Value name="textSize" value="15px" />
        <Value name="textMaxWidth" value="540px" />
    </Profile>

    <!-- ============================================================= -->
    <!-- Track list (FS25 SmoothList: standalone layout profile, no removed base) -->
    <!-- ============================================================= -->

    <Profile name="guidanceSteeringTracksListBox" extends="emptyPanel" with="anchorTopLeft">
        <Value name="position" value="0px 0px" />
        <Value name="size" value="454px 500px" />
    </Profile>

    <Profile name="trackList" extends="emptyPanel" with="anchorTopLeft">
        <Value name="size" value="425px 500px" />
        <Value name="selectOnScroll" value="true" />
        <Value name="isHorizontalList" value="false" />
        <Value name="itemsPerCol" value="11" />
        <Value name="listItemHeight" value="45.45px" />
        <Value name="listItemWidth" value="425px" />
        <Value name="rowBackgroundProfile" value="trackListItem" />
        <Value name="rowBackgroundProfileAlternate" value="trackListItemAlternate" />
    </Profile>

    <Profile name="trackListItem">
        <Value name="type" value="listItem" />
        <Value name="imageColor" value="$preset_colorListRowBackground" />
        <Value name="imageFocusedColor" value="$preset_colorMainUI" />
        <Value name="imageSelectedColor" value="$preset_colorMainUI" />
        <Value name="size" value="400px 46.86px" />
        <Value name="position" value="0px 0px" />
    </Profile>
    <Profile name="trackListItemAlternate" extends="trackListItem" with="gsAlternateRow" />

    <Profile name="trackListItemTitle" extends="gsTextBase">
        <Value name="size" value="400px 46px" />
        <Value name="textMaxWidth" value="400px" />
        <Value name="textVerticalAlignment" value="middle" />
        <Value name="textSize" value="16px" />
        <Value name="textBold" value="false" />
        <Value name="textOffset" value="40px 2px" />
        <Value name="textFocusedOffset" value="40px 2px" />
    </Profile>

    <Profile name="trackListItemGroup" extends="trackListItem">
        <Value name="imageColor" value="$preset_colorGlassExtremelyLight" />
        <Value name="allowFocus" value="false" />
    </Profile>

    <Profile name="trackListItemGroupTitle" extends="trackListItemTitle">
        <Value name="textBold" value="true" />
        <Value name="textOffset" value="30px 2px" />
        <Value name="textFocusedOffset" value="30px 2px" />
        <Value name="textSize" value="18px" />
    </Profile>
</GUIProfiles>
