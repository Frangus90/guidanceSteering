<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    FS25 Guidance Steering - Settings page (rebuilt on the standard FS25 settings-page
    pattern, mirroring GIANTS' GlobalSettingsFrame as used by Courseplay).

    Structure:
      fs25_menuContainer                       fills the paging area (so only the active
                                               page renders; no stray floating boxes)
        fs25_menuHeaderPanel                   icon + title (set in Lua)
        fs25_lineSeparatorTopHighlighted
        fs25_subCategorySelectorTabbedContainer
          ScrollingLayout (fs25_settingsLayout, id=boxLayoutSettings)   the scrolling rows
          fs25_stopClipper (bottomClipper)
        fs25_sliderDockedBg/Box + Slider (fs25_sliderDocked)            docked scrollbar
        gsTooltipText (id=settingsHelpBoxText)                          help line (a Text)

    Each toggle/selector is a bare <MultiTextOption profile="fs25_settingsMultiTextOption">;
    that base profile auto-adds its left/right arrow buttons, value text and background, so
    only the "label" (row title) child is declared. Every element the Lua drives keeps its
    original id. Tooltips route to settingsHelpBoxText (a Text with setText), NOT a Bitmap.
-->
<GUI name="guidanceSteeringSettings">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="settingsHeaderIcon" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="settingsHeaderText" />
        </GuiElement>

        <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="0px -57px" />

        <!-- Content region, pinned with its TOP just under the header separator and its BOTTOM
             above the help line. fs25_subCategorySelectorTabbedContainer is normally a per-subcategory
             prefab that base/Courseplay reposition in Lua; used statically its default placement leaves
             a large gap below the header (room a subcategory tab strip would occupy — we have none).
             GROUND TRUTH (GUI_DEBUG dump + GuiElement:updateAnchorDeltas): FS25's Y origin is
             bottom-left and #position is an offset from the parent's BOTTOM-left corner, so the old
             "-62px" pinned this box's BOTTOM 62px below the parent bottom; its 750px-tall (@ref) body
             then overran upward, landing the top at 624px @2160p (a 170px dead gap under the separator)
             and the bottom past the window edge. We instead pick position.y + height so the box top
             lands ~476px @2160p (topFrac 0.7801) and its bottom ~1850px (above the help text at 1872).
             Parent 'container': bottom=0.0741, top=0.8426. height=687px (0.6361 frac = 1375px @2160p),
             so position.y = (0.7801 - 0.6361) - 0.0741 = 0.0694 frac = 75px (ref; Y = px/1080).
             The boxLayoutSettings viewport tracks this height (100%), so the scroll region shrinks with
             it; content still scrolls slightly (accepted) but the last row stays reachable at max scroll.
             anchors="0 0 1 1" is kept but is a no-op for a static parent (it only changes how frozen
             deltas re-expand on a parent resize); only position/size determine the final rectangle. -->
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="settingsContainer" visible="true"
                    anchors="0 0 1 1" position="0px 75px" height="687px">
            <ScrollingLayout profile="fs25_settingsLayout" id="boxLayoutSettings" bottomClipperElementName="bottomClipper">

                <!-- ============ General ============ -->
                <Text profile="gsSectionHeader" text="$l10n_ui_ingameMenuGameSettingsGeneral" />

                <Bitmap profile="gsMultiTextOptionContainer" focusFallthrough="true">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="guidanceSteeringEnableSteeringElement"
                                toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_enableGuidanceSteering">
                        <Text profile="gsSettingsMultiOptionTitle" name="label" text="$l10n_guidanceSteering_setting_enableGuidanceSteering" />
                    </MultiTextOption>
                </Bitmap>

                <Bitmap profile="gsMultiTextOptionContainer" focusFallthrough="true">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="guidanceSteeringSnapAngleElement"
                                toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_terrainAngleSnap">
                        <Text profile="gsSettingsMultiOptionTitle" name="label" text="$l10n_guidanceSteering_setting_terrainAngleSnap" />
                    </MultiTextOption>
                </Bitmap>

                <Bitmap profile="gsMultiTextOptionContainer" focusFallthrough="true">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="guidanceSteeringAutoInvertOffsetElement"
                                toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_autoInvertOffset">
                        <Text profile="gsSettingsMultiOptionTitle" name="label" text="$l10n_guidanceSteering_setting_autoInvertOffset" />
                    </MultiTextOption>
                </Bitmap>

                <!-- ============ Lines ============ -->
                <Text profile="gsSectionHeader" text="$l10n_guidanceSteering_setting_header_lines" />

                <Bitmap profile="gsMultiTextOptionContainer" focusFallthrough="true">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="guidanceSteeringShowLinesElement"
                                toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_showLines">
                        <Text profile="gsSettingsMultiOptionTitle" name="label" text="$l10n_guidanceSteering_setting_showLines" />
                    </MultiTextOption>
                </Bitmap>

                <Bitmap profile="gsMultiTextOptionContainer" focusFallthrough="true">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="guidanceSteeringShowLinesAsDotsElement"
                                toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_showLinesAsDots">
                        <Text profile="gsSettingsMultiOptionTitle" name="label" text="$l10n_guidanceSteering_setting_showLinesAsDots" />
                    </MultiTextOption>
                </Bitmap>

                <Bitmap profile="gsMultiTextOptionContainer" focusFallthrough="true">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="guidanceSteeringLinesOffsetElement"
                                toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_offsetLines">
                        <Text profile="gsSettingsMultiOptionTitle" name="label" text="$l10n_guidanceSteering_setting_offsetLines" />
                    </MultiTextOption>
                </Bitmap>

                <!-- ============ Headland ============ -->
                <Text profile="gsSectionHeader" text="$l10n_guidanceSteering_setting_header_headland" />

                <Bitmap profile="gsMultiTextOptionContainer" focusFallthrough="true">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="guidanceSteeringHeadlandModeElement"
                                toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_headlandMode">
                        <Text profile="gsSettingsMultiOptionTitle" name="label" text="$l10n_guidanceSteering_setting_headlandMode" />
                    </MultiTextOption>
                </Bitmap>

                <GuiElement profile="gsTextInputRow">
                    <Text profile="gsRowLabel" position="0px 5px" text="$l10n_guidanceSteering_setting_headlandDistance" />
                    <TextInput profile="gsTextInput" position="320px 4px" id="guidanceSteeringHeadlandDistanceElement"
                                toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_headlandDistance"
                                maxCharacters="5" imeKeyboardType="normal" onTextChanged="onHeadlandDistanceChanged" />
                </GuiElement>

                <!-- Headland passes: pass-count selector + Generate action (slice 1). -->
                <Bitmap profile="gsMultiTextOptionContainer" focusFallthrough="true">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="guidanceSteeringHeadlandPassCountElement"
                                toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_headlandPasses">
                        <Text profile="gsSettingsMultiOptionTitle" name="label" text="$l10n_guidanceSteering_setting_headlandPasses" />
                    </MultiTextOption>
                </Bitmap>

                <GuiElement profile="gsButtonRow">
                    <ThreePartBitmap profile="gsButtonPill" position="0px 5px" size="300px 45px" />
                    <Button profile="gsSettingsButtonWide" position="0px 5px" size="300px 45px" text="$l10n_guidanceSteering_setting_generateHeadland" onClick="onClickGenerateHeadland" id="guidanceSteeringGenerateHeadlandButton"
                                toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_generateHeadland" />
                </GuiElement>

                <!-- ============ Width ============ -->
                <Text profile="gsSectionHeader" text="$l10n_guidanceSteering_setting_width" />

                <Bitmap profile="gsMultiTextOptionContainer" focusFallthrough="true">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="guidanceSteeringWidthIncrementElement"
                                toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_widthInCrement">
                        <Text profile="gsSettingsMultiOptionTitle" name="label" text="$l10n_guidanceSteering_setting_widthIncrement" />
                    </MultiTextOption>
                </Bitmap>

                <GuiElement profile="gsButtonRow">
                    <Text profile="gsRowLabel" position="0px 5px" text="$l10n_guidanceSteering_setting_width" />
                    <Text profile="gsValueText" id="guidanceSteeringWidthText" position="300px 5px" text="0.00 m" />
                    <ThreePartBitmap profile="gsButtonPill" position="480px 5px" size="60px 45px" />
                    <Button profile="gsSettingsButton" position="480px 5px" text="-" onClick="onClickDecrementWidth" id="guidanceSteeringMinusButton" />
                    <ThreePartBitmap profile="gsButtonPill" position="550px 5px" size="60px 45px" />
                    <Button profile="gsSettingsButton" position="550px 5px" text="+" onClick="onClickIncrementWidth" id="guidanceSteeringPlusButton" />
                    <ThreePartBitmap profile="gsButtonPill" position="630px 5px" size="170px 45px" />
                    <Button profile="gsSettingsButtonWide" position="630px 5px" text="Reset" onClick="onClickResetWidth" id="guidanceSteeringResetWidthButton" />
                    <ThreePartBitmap profile="gsButtonPill" position="810px 5px" size="170px 45px" />
                    <Button profile="gsSettingsButtonWide" position="810px 5px" text="$l10n_guidanceSteering_setting_autoWidth" onClick="onClickAutoWidth" id="guidanceSteeringAutoWidthButton" />
                </GuiElement>

                <!-- ============ Offset ============ -->
                <Text profile="gsSectionHeader" text="$l10n_guidanceSteering_setting_offsetWidth" />

                <Bitmap profile="gsMultiTextOptionContainer" focusFallthrough="true">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="guidanceSteeringOffsetIncrementElement"
                                toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_offsetIncrement">
                        <Text profile="gsSettingsMultiOptionTitle" name="label" text="$l10n_guidanceSteering_setting_offsetIncrement" />
                    </MultiTextOption>
                </Bitmap>

                <GuiElement profile="gsButtonRow">
                    <Text profile="gsRowLabel" position="0px 5px" text="$l10n_guidanceSteering_setting_offsetWidth" />
                    <Text profile="gsValueText" id="guidanceSteeringOffsetWidthText" position="300px 5px" text="0.00 m" />
                    <ThreePartBitmap profile="gsButtonPill" position="480px 5px" size="60px 45px" />
                    <Button profile="gsSettingsButton" position="480px 5px" text="-" onClick="onClickDecrementOffsetWidth" id="guidanceSteeringMinusOffsetButton" />
                    <ThreePartBitmap profile="gsButtonPill" position="550px 5px" size="60px 45px" />
                    <Button profile="gsSettingsButton" position="550px 5px" text="+" onClick="onClickIncrementOffsetWidth" id="guidanceSteeringPlusOffsetButton" />
                    <ThreePartBitmap profile="gsButtonPill" position="630px 5px" size="170px 45px" />
                    <Button profile="gsSettingsButtonWide" position="630px 5px" text="Reset" onClick="onClickResetOffsetWidth" id="guidanceSteeringResetOffsetButton" />
                    <ThreePartBitmap profile="gsButtonPill" position="810px 5px" size="170px 45px" />
                    <Button profile="gsSettingsButtonWide" position="810px 5px" text="$l10n_guidanceSteering_setting_invertOffset" onClick="onClickInvertOffset" id="guidanceSteeringInvertOffsetButton" />
                </GuiElement>

            </ScrollingLayout>
            <Bitmap profile="fs25_stopClipper" name="bottomClipper" />
        </GuiElement>

        <ThreePartBitmap profile="fs25_sliderDockedBg" id="settingsSliderBox">
            <ThreePartBitmap profile="fs25_sliderDockedBox">
                <Slider profile="fs25_sliderDocked" id="settingsSlider" dataElementId="boxLayoutSettings" />
            </ThreePartBitmap>
        </ThreePartBitmap>

        <!-- Help line (a Text, so GuiElement:onFocusEnter -> toolTipElement:setText works). -->
        <Text profile="gsTooltipText" id="settingsHelpBoxText" text="" />
    </GuiElement>
</GUI>
